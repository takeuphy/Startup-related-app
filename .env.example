# ============================================================
# AI Provider Configuration
# ============================================================

# AI_PROVIDER: 使用するAIサービスを選択
# - gemini (デフォルト、推奨 - 無料枠あり、低コスト)
# - openai
AI_PROVIDER=gemini

# Google Gemini API Key (推奨 - コスト効率が良い)
# 取得先: https://aistudio.google.com/app/apikey
# 無料枠: 1分あたり15リクエスト、1日1500リクエスト
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (AI_PROVIDER=openai の場合に必要)
# 取得先: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# Server Configuration
# ============================================================

# Server port (default: 3000)
PORT=3000
